{
  "mcpServers": {
    "dingtalk": {
      "enabled": true,
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "dingtalk-mcp@1.1.21"],
      "env": {
        "DINGTALK_Client_ID": "$DINGTALK_CLIENT_ID",
        "DINGTALK_Client_Secret": "$DINGTALK_CLIENT_SECRET",
        "ACTIVE_PROFILES": "$DINGTALK_ACTIVE_PROFILES",
        "DINGTALK_AGENT_ID": "$DINGTALK_AGENT_ID",
        "ROBOT_CODE": "$ROBOT_CODE",
        "ROBOT_ACCESS_TOKEN": "$ROBOT_ACCESS_TOKEN"
      },
      "description": "钉钉 MCP 服务"
    },
    "rag-knowledge-base": {
      "enabled": true,
      "type": "stdio",
      "command": "python",
      "args": ["../mcp-server/server.py"],
      "description": "Local RAG knowledge base query service"
    }
  }
}
