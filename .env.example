# ============================================================
# AI Note Backend — Environment Variables Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# LLM Provider (required)
# Get your key at https://open.bigmodel.cn/ (智谱 AI)
GLM_API_KEY=your_key_here
GLM_MODEL=glm-5.1
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# GLM_MAX_TOOLS=0   # 0 = auto; set a number to enable tool-routing threshold

# Web Search — Tavily (optional)
# Get your key at https://tavily.com/
TAVILY_API_KEY=your_key_here

# Audio Transcription — Groq Whisper (optional)
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=your_key_here
GROQ_BASE_URL=https://api.groq.com
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Database — PostgreSQL / Supabase (optional; falls back to in-memory if unset)
# Get your connection string at Supabase → Settings → Database → Connection string → Session pooler
# Format: postgresql://postgres.<ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# DingTalk MCP (optional)
# Get AppKey / AppSecret at https://open-dev.dingtalk.com/ → 应用开发 → 凭证与基础信息
DINGTALK_MCP_ENABLED=false
DINGTALK_CLIENT_ID=your_appkey
DINGTALK_CLIENT_SECRET=your_appsecret
DINGTALK_ACTIVE_PROFILES=ALL
# DINGTALK_AGENT_ID=
# ROBOT_CODE=
# ROBOT_ACCESS_TOKEN=
