# ============================================================
# AI Note Backend — Environment Variables Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# Supabase 登录鉴权 — 项目 URL（可选，建议生产配置）
# 前端用 Supabase 登录拿到 access_token（JWT），业务请求带
#   Authorization: Bearer <access_token>
# 后端从 <url>/auth/v1/.well-known/jwks.json 取 JWT Signing Keys（ES256 公钥）
# 按 token 的 kid 验签，从 sub claim 解析真实 user_id。key 轮换无需改代码。
#   - 留空 = 跳过鉴权（开发模式，一律 user_id=default）
#   - 填上后：无 token → default；坏/过期 token → 401
# 获取：Supabase → Project Settings → API → Project URL（形如 https://xxxx.supabase.co）
SUPABASE_URL=

# LLM Provider (model selection is driven by config.yaml — see config.yaml
# in the project root. These GLM_* vars are only used as the legacy fallback
# when no config.yaml exists.)
# Get your key at https://open.bigmodel.cn/ (智谱 AI)
GLM_API_KEY=your_key_here
GLM_MODEL=glm-5.1
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# GLM_MAX_TOOLS=0   # 0 = auto; set a number to enable tool-routing threshold

# DeepSeek API key — referenced by the `deepseek-chat` entry in config.yaml
# via `api_key_env: DEEPSEEK_API_KEY`. Get your key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_key_here

# Web Search — Tavily (optional)
# Get your key at https://tavily.com/
TAVILY_API_KEY=your_key_here

# Audio Transcription — Groq Whisper (optional)
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=your_key_here
GROQ_BASE_URL=https://api.groq.com
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Database — PostgreSQL / Supabase (optional; falls back to in-memory if unset)
# Get your connection string at Supabase → Settings → Database → Connection string → Session pooler
# Format: postgresql://postgres.<ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# DingTalk MCP (optional)
# Get AppKey / AppSecret at https://open-dev.dingtalk.com/ → 应用开发 → 凭证与基础信息
DINGTALK_MCP_ENABLED=false
DINGTALK_CLIENT_ID=your_appkey
DINGTALK_CLIENT_SECRET=your_appsecret
DINGTALK_ACTIVE_PROFILES=ALL
# DINGTALK_AGENT_ID=
# ROBOT_CODE=
# ROBOT_ACCESS_TOKEN=
