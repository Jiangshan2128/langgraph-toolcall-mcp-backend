# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment-specific config
.env

# MCP server configuration (copy from mcp_servers.example.json)
mcp_servers.json

# Qdrant local vector store (runtime data, auto-generated)
mcp/knowledge_base/qdrant_data/

# RAG index cache (auto-generated MD5 hashes)
mcp/knowledge_base/documents/.index_cache.json

# Knowledge base documents (local files, not code)
mcp/knowledge_base/documents/*.docx
mcp/knowledge_base/documents/*.md

# Office temp files
~$*

# IDE / tool caches
.cache/

# Test artifacts
qdrant_data_test_copy/
chunks_report.txt
